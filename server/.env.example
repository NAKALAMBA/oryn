# Copy this file to .env. MSG91_AUTH_KEY is optional — if it's left blank,
# email validation at checkout is skipped entirely (orders are still
# accepted normally). Never commit your real .env file, and never paste
# real secrets into chat.

PORT=3001

# ── Email validation (MSG91) ───────────────────────────────────────────────
# Catches a mistyped/undeliverable email at checkout before the order is
# accepted. Only blocks an order when MSG91 explicitly reports the address
# as undeliverable/invalid — any other outcome (including this key being
# unset, or the request failing) lets the order through as normal.
# 1. Sign up / log in at https://control.msg91.com
# 2. Get your auth key from Settings > API Keys
# 3. This same key also works for MSG91's "Validate Email" dashboard tool
#    (Email > Validate Email), which is useful for spot-checking addresses
#    by hand.
MSG91_AUTH_KEY=

# ── Shipping (Shiprocket) ──────────────────────────────────────────────────
# Stages a Shiprocket shipment the instant a checkout order is saved. If any
# of these are unset, or Shiprocket rejects/is unreachable, the order still
# saves normally — the failure is just recorded on the order (visible in the
# admin dashboard's Shiprocket column) instead of blocking the customer.
# 1. Shiprocket dashboard -> Settings -> API -> Add New API User. Use a
#    dedicated email/password here, NOT your main Shiprocket login
#    (Shiprocket's own recommended practice).
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
# 2. Shiprocket dashboard -> Settings -> Pickup Addresses. Must match the
#    pickup location's nickname exactly.
SHIPROCKET_PICKUP_LOCATION=
# Optional overrides — a per-shipment default since individual products
# don't carry their own weight/dimensions yet. Values: kg, cm, cm, cm.
SHIPROCKET_DEFAULT_WEIGHT_KG=0.5
SHIPROCKET_DEFAULT_LENGTH_CM=20
SHIPROCKET_DEFAULT_BREADTH_CM=15
SHIPROCKET_DEFAULT_HEIGHT_CM=10
# "Prepaid" (default) or "COD" — declared to Shiprocket per order.
SHIPROCKET_PAYMENT_METHOD=Prepaid
# Optional, only needed if you use Shiprocket's multi-channel feature.
SHIPROCKET_CHANNEL_ID=

# ── Supabase (the ONLY datastore — required) ──────────────────────────────
# Every order, contact message, newsletter subscriber and event
# registration is stored in Supabase and nowhere else. There is no local
# database. If these are unset or Supabase is unreachable, the form
# endpoints return 502.
# 1. Supabase Dashboard -> Project Settings -> API -> Project URL + the
#    `service_role` / secret key (NOT the publishable key — that one is
#    browser-only and lives in js/supabase-config.js).
# 2. Run server/supabase-orders-schema.sql then server/supabase-admin-schema.sql
#    once each in the Supabase SQL Editor.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Admin panel (/admin) ──────────────────────────────────────────────────
# ADMIN_PASSWORD gates the panel — one shared password, swapped for a signed
# session token at POST /api/admin/login. If UNSET in production the admin
# API fails closed (503). ADMIN_TOKEN_SECRET signs the tokens; any long
# random string (falls back to ADMIN_PASSWORD if unset).
ADMIN_PASSWORD=
ADMIN_TOKEN_SECRET=
